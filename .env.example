# =============================================================================
# SOUL x TIME — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# =============================================================================
# FRONTEND (Next.js)
# =============================================================================

# Backend API URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Brand configuration (public)
NEXT_PUBLIC_BRAND_NAME=SOUL x TIME
NEXT_PUBLIC_BRAND_SLOGAN=Where Time Finds Its Soul

# =============================================================================
# BACKEND (Spring Boot)
# =============================================================================

# Active profiles: local | staging | production
SPRING_PROFILES_ACTIVE=local

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================

DATABASE_URL=jdbc:postgresql://localhost:5432/soulxtime
DATABASE_USERNAME=soulxtime_user
DATABASE_PASSWORD=change_me_secure_password

# =============================================================================
# AUTHENTICATION (JWT)
# =============================================================================

# Minimum 256 bits / 32 chars — use a cryptographically random value
JWT_SECRET=change_me_to_a_256_bit_random_secret_string_minimum_32_chars

# Access token expiry: 15 minutes
JWT_ACCESS_EXPIRY_MS=900000

# Refresh token expiry: 7 days
JWT_REFRESH_EXPIRY_MS=604800000

# Cookie domain (set to your domain in production)
JWT_COOKIE_DOMAIN=localhost

# =============================================================================
# CORS
# =============================================================================

# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# WHATSAPP INTEGRATION
# =============================================================================

# LINK = generate WhatsApp link (development safe, no API key needed)
# API  = use WhatsApp Business API (requires WHATSAPP_API_TOKEN)
WHATSAPP_MODE=LINK

# Owner WhatsApp number in international format (no + or spaces)
# Example: 919876543210 for +91 9876543210
WHATSAPP_OWNER_NUMBER=

# WhatsApp Business API endpoint (only if WHATSAPP_MODE=API)
WHATSAPP_API_URL=

# WhatsApp Business API token (only if WHATSAPP_MODE=API)
WHATSAPP_API_TOKEN=

# =============================================================================
# MEDIA / STORAGE
# =============================================================================

# Base URL for product images (local dev: your static server; prod: CDN)
MEDIA_BASE_URL=http://localhost:8080/media

# =============================================================================
# BILL NUMBERING
# =============================================================================

# Bill number prefix pattern (do not change after going live)
BILL_NUMBER_PREFIX=ST

# =============================================================================
# ADMIN CONFIGURATION
# =============================================================================

# Admin/owner display name (for invoices)
ADMIN_OWNER_NAME=Soul x Time Admin
ADMIN_OWNER_PHONE=+91 00000 00000

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

# LOG_LEVEL: ERROR | WARN | INFO | DEBUG (use INFO in production)
LOG_LEVEL=INFO

# Sentry DSN (optional — for error monitoring)
SENTRY_DSN=
